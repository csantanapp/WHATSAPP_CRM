{
	email suporte@tractom.com.br
}

# Site de vendas (infra/site do repositório). /login entra direto na
# instalação da empresa (<cliente>.chatpipe.com.br).
www.chatpipe.com.br {
	redir https://chatpipe.com.br{uri} permanent
}

chatpipe.com.br {
	root * /srv/site
	redir /entrar /login permanent
	encode zstd gzip
	try_files {path} {path}.html
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	@html path / /index.html /login /login.html
	header @html Cache-Control "no-cache"
	file_server
}

# Um arquivo por cliente em ./sites (gerado pelo novo-cliente.sh).
import /etc/caddy/sites/*.caddy
