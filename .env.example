PORT=3000

# Postgres
DATABASE_URL=postgres://user:password@localhost:5432/whatsapp_crm

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=

# Instagram Direct (DMs) — Instagram profissional (Business/Creator) vinculado
# a uma Página do Facebook, autorizada no app da Meta com permissão de
# mensagens (instagram_manage_messages, pages_messaging). O PAGE_ID e o token
# são os mesmos da Página do Facebook que está ligada ao Instagram.
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_PAGE_ID=
INSTAGRAM_VERIFY_TOKEN=change-me
# Opcional: só preencher se o Instagram estiver configurado num app da Meta
# diferente do WhatsApp. Se vazio, usa WHATSAPP_APP_SECRET.
INSTAGRAM_APP_SECRET=
