PORT=3000

# Postgres
DATABASE_URL=postgres://user:password@localhost:5432/whatsapp_crm

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=

# Instagram Direct (DMs) — Instagram profissional (Business/Creator) vinculado
# a uma Página do Facebook, autorizada no app da Meta com permissão de
# mensagens (instagram_manage_messages, pages_messaging). O PAGE_ID e o token
# são os mesmos da Página do Facebook que está ligada ao Instagram.
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_PAGE_ID=
INSTAGRAM_VERIFY_TOKEN=change-me
# Opcional: só preencher se o Instagram estiver configurado num app da Meta
# diferente do WhatsApp. Se vazio, usa WHATSAPP_APP_SECRET.
INSTAGRAM_APP_SECRET=

# Transcrição de áudio do WhatsApp — usa Whisper local (container próprio,
# sem custo) via WHISPER_LOCAL_URL; definido automaticamente no docker-compose
# em produção. Só configure OPENAI_API_KEY se quiser usar a API paga da OpenAI
# como alternativa (tem prioridade menor que o local, ver TranscriptionService.js).
WHISPER_LOCAL_URL=http://whisper:9000
OPENAI_API_KEY=
